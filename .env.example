# Where the shared catalogue API lives. Locally that is the other repo running on 8077.
MIST_CATALOGUE_API=http://127.0.0.1:8077

# The app's own database. SQLite locally; set a postgres:// URL on Railway.
MIST_APP_DB=data/planetprocure.db

# Which client this instance serves (one tenant per deployment for now).
MIST_TENANT=tudelft

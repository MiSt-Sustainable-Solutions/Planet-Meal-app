# ---------------------------------------------------------------- where things are
# The shared catalogue API. Locally that is the other repo running on 8077.
MIST_CATALOGUE_API=http://127.0.0.1:8077

# This app's own database. SQLite locally; set a postgres:// URL on Railway.
MIST_APP_DB=data/planetprocure.db

# The client this deployment started with. Every client after that is added with
#   python auth.py add-tenant <id> --name "<Client name>"
MIST_TENANT=tudelft

# ---------------------------------------------------------------- secrets
# Signs the session cookie. MUST be set in production, and MUST stay the same across
# restarts: change it and everyone is logged out; guess it and anyone can forge an
# admin session. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MIST_SECRET_KEY=

# Keys for the catalogue's WRITE endpoints. Reading needs neither.
#   the app key   lets this app teach the catalogue a new product (routine, every import)
#   the admin key lets it file curated decisions, which outrank every rule for EVERY
#                 client, permanently. Only a MiSt deployment should hold this one.
# They must match MIST_APP_KEY and MIST_ADMIN_KEY on the catalogue side.
MIST_CATALOGUE_KEY=
MIST_CATALOGUE_ADMIN_KEY=

# ---------------------------------------------------------------- environment
# Set to "production" on Railway. It turns on secure-only cookies and makes the app
# refuse to start without MIST_SECRET_KEY rather than quietly signing with a throwaway.
MIST_ENV=development

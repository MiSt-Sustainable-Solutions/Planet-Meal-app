# the app's own database — derived, rebuildable by seeding from the catalogue repo
data/*.db
data/*.db-journal

# client data received through the app — NEVER commit purchase files
data/uploads/

# Excel lock files, created whenever someone has a workbook open
~$*

# Sample and generated workbooks. These carry real Sligro article numbers, real
# barcodes, and the client's own account numbers and outlet names -- which is what
# makes them useful for testing and exactly why they must not be published. They
# live on disk and in Drive; they do not belong in a repository, least of all a
# public one.
data/*.xlsx

# python
__pycache__/
*.pyc
.venv/
venv/
.env

# os
Thumbs.db
.DS_Store
